<Window x:Class="КР.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:КР"
        WindowState="Maximized"
        mc:Ignorable="d"
        Title="Университетская система синхронизации" Height="770" Width="1200">
    <Window.Resources>
        <!-- Цветовая схема-->
        <SolidColorBrush x:Key="PrimaryColor" Color="#1976D2"/>
        <SolidColorBrush x:Key="MouseOverButton" Color="#1565C0"/>
        <SolidColorBrush x:Key="PressedButton" Color="#0D47A1"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#424242"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FF9800"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
        <SolidColorBrush x:Key="SuccessMouseColor" Color="#2E7D32"/>
        <SolidColorBrush x:Key="BackButtonColor" Color="#757575"/>
        <SolidColorBrush x:Key="BackDelColor" Color="#D32F2F"/>
        <SolidColorBrush x:Key="MouseDelColor" Color="#C62828"/>
        <SolidColorBrush x:Key="BorderColor" Color="#BDBDBD"/>

        <Color x:Key="PrimColor">#1976D2</Color>
        <Color x:Key="DarkPrimColor">#0D47A1</Color>
        <Color x:Key="AccColor">#FF9800</Color>
        <Color x:Key="SuccColor">#4CAF50</Color>
        <Color x:Key="StatusColor">#757575</Color>

        <!-- Стили для кнопок -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource MouseOverButton}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource PressedButton}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource BackButtonColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SecondaryColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource BackDelColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource MouseDelColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessMouseColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Стили TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="5,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Стили для DataGrid-->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Заголовок-->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource DarkPrimColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource PrimColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="20,10">
                <TextBlock Text="🎓 UNIVERSITY SYNC" FontSize="30" FontWeight="Bold" 
                           Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="Система синхронизации данных университета" FontSize="16" 
                           Foreground="White"/>
            </StackPanel>
        </Border>
        <!-- Уровни-->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Текущий уровень:" VerticalAlignment="Center" FontSize="16"
                           FontWeight="SemiBold" Margin="0,0,20,0" Foreground="{StaticResource SecondaryColor}"/>
                <RadioButton x:Name="RadioUniversity" Content="Ректорат" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="16" Click="Level_Click"
                             GroupName="LevelGroup" Foreground="{StaticResource PrimaryColor}"/>
                <RadioButton x:Name="RadioFaculty" Content="Факультет ИТ" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="16" Click="Level_Click"
                             GroupName="LevelGroup" Foreground="{StaticResource PrimaryColor}"/>
                <RadioButton x:Name="RadioDept" Content="Кафедра ПО" VerticalAlignment="Center" Margin="0,0,70,0" FontSize="16" Click="Level_Click"
                             GroupName="LevelGroup" Foreground="{StaticResource PrimaryColor}"/>
                <Button x:Name ="BtnSync" Content="Синхронизировать" Style="{StaticResource SuccessButton}" Padding="20,10" FontSize="16" Click="Sync_Click"/> 
            </StackPanel>
        </Border>

        <!-- Вкладки -->
        <TabControl Grid.Row="2" Margin="20" Background="White" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Padding" Value="20,10"/>
                    <Setter Property="Foreground" Value="{StaticResource BackButtonColor}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="White" CornerRadius="5" 
                                        Margin="0,0,2,0" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryColor}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <!-- Вкладка 1-->
            <TabItem Header="Структура университета">
                <Border Background="White" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Факультеты -->
                        <GroupBox Grid.Column="0" Header="Факультеты" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryColor}" Margin="5,5,5,40">
                            <GroupBox.BorderBrush>
                                <SolidColorBrush Color="{StaticResource PrimColor}"/>
                            </GroupBox.BorderBrush>
                            <StackPanel>
                                <DataGrid x:Name="GridFaculties" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" 
                                          IsReadOnly="True" Height="265" Margin="0,0,0,10" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn  Header="Название" Binding="{Binding Name}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBox x:Name="TxtFacultyName" Style="{StaticResource ModernTextBox}" 
                                         Margin="0,0,0,8" Text="Введите название факультета..."/>
                                <Button x:Name="BtnAddFaculty" Content="Добавить факультет" FontSize="16" Click="AddFaculty_Click" 
                                        Style="{StaticResource ModernButton}" Margin="0,0,0,8"/>
                                <Button x:Name="BtnDeleteFaculty" Content="Удалить" FontSize="16" Click="DeleteFaculty_Click"  
                                        Style="{StaticResource DeleteButton}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Кафедры -->
                        <GroupBox Grid.Column="1" Header="Кафедры" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" Margin="5,5,5,40">
                            <GroupBox.BorderBrush>
                                <SolidColorBrush Color="{StaticResource AccColor}"/>
                            </GroupBox.BorderBrush>
                            <StackPanel>
                                <DataGrid x:Name="GridDepartments" Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False" 
                                          IsReadOnly="True"  Height="265" Margin="0,0,0,10" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Факультет" Binding="{Binding FacultyName}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBox x:Name="TxtDeptName" Style="{StaticResource ModernTextBox}" 
                                         Margin="0,0,0,8" Text="Введите название кафедры..."/>
                                <Button x:Name ="BtnAddDept" Content="Добавить кафедру" FontSize="16" Click="AddDepartment_Click" 
                                        Style="{StaticResource ModernButton}" Margin="0,0,0,8"/>
                                <Button x:Name="BtnDeleteDept" Content="Удалить" FontSize="16" Click="DeleteDepartment_Click" 
                                        Style="{StaticResource DeleteButton}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Направления -->
                        <GroupBox Grid.Column="2" Header="Направления подготовки" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SuccessColor}" Margin="5,5,5,40">
                            <GroupBox.BorderBrush>
                                <SolidColorBrush Color="{StaticResource SuccColor}"/>
                            </GroupBox.BorderBrush>
                            <StackPanel>
                                <DataGrid x:Name="GridPrograms" Style="{StaticResource ModernDataGrid}"
                                          AutoGenerateColumns="False" IsReadOnly="True" 
                                          Height="230" Margin="0,0,0,10" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="90"/>
                                        <DataGridTextColumn Header="Профиль" Binding="{Binding Profile}" Width="*"/>
                                        <DataGridTextColumn Header="Кафедра" Binding="{Binding DeptmentName}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBox x:Name="TxtProgCode" Style="{StaticResource ModernTextBox}" 
                                         Margin="0,0,0,2" Text="09.03.04"/>
                                <TextBox x:Name="TxtProgProfile" Style="{StaticResource ModernTextBox}" 
                                         Margin="0,0,0,5" Text="Разработка информационных систем"/>
                                <Button x:Name="BtnAddProgram" Content="Добавить направление" FontSize="16" Click="AddProgram_Click" 
                                        Style="{StaticResource ModernButton}" Margin="0,0,0,3"/>
                                <Button x:Name ="BtnDeleteProgram" Content="Удалить" FontSize="16" Click="DeleteProgram_Click" 
                                        Style="{StaticResource DeleteButton}"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </Border>
            </TabItem>
            <!-- Вкладка 2 -->
            <TabItem Header="Студенты">
                <Border Background="White" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <DataGrid x:Name="GridStudents" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" Height="400" Margin="0,0,0,15">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="Группа" Binding="{Binding GroupNumber}" Width="180"/>
                                <DataGridTextColumn Header="Год поступления" Binding="{Binding EnrollmentYear}" Width="130"/>
                                <DataGridTextColumn Header="Направление" Binding="{Binding Profile}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtStudentName" Style="{StaticResource ModernTextBox}" 
                                     Width="250" Margin="0,0,10,0" Text="Иванов Иван Иванович"/>
                            <TextBox x:Name="TxtStudentGroup" Style="{StaticResource ModernTextBox}" 
                                     Width="180" Margin="0,0,10,0" Text="Б.ПИН.РИС.25.06"/>
                            <TextBox x:Name="TxtStudentYear" Style="{StaticResource ModernTextBox}" 
                                     Width="100" Margin="0,0,10,0" Text="2025"/>
                            <ComboBox x:Name="CmbPrograms" DisplayMemberPath="DisplayName" Width="240" Margin="0,0,10,0" SelectedValuePath="Id"/>
                            <Button x:Name="BtnAddStudent" Content="Добавить студента" FontSize="16" Click="AddStudent_Click"
                                    Style="{StaticResource ModernButton}" Margin="0,0,10,0"/>
                            <Button x:Name="BtnDeleteStudent" Content="Удалить" FontSize="16" Click="DeleteStudent_Click"
                                    Style="{StaticResource DeleteButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
            <!-- Вкладка 3 -->
            <TabItem Header="Успеваемость">
                <Border Background="White" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <DataGrid x:Name="GridGrades" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" Height="400" Margin="0,0,0,15">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="120"/>
                                <DataGridTextColumn Header="Студент" Binding="{Binding StudentName}" Width="*"/>
                                <DataGridTextColumn Header="Предмет" Binding="{Binding Subject}" Width="*"/>
                                <DataGridTextColumn Header="Оценка" Binding="{Binding Grade}" Width="100"/>
                                <DataGridTextColumn Header="Преподаватель" Binding="{Binding Teacher}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="DateGrade" Width="130" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                            <ComboBox x:Name="CmbStudents" Width="300" Margin="0,0,10,0" 
                                      DisplayMemberPath="DisplayName"  ToolTip="Выберите студента из списка"/>
                            <TextBox x:Name="TxtGradeSubject" Style="{StaticResource ModernTextBox}" 
                                     Width="200" Margin="0,0,10,0" Text="Базы данных"/>
                            <TextBox x:Name="TxtGradeValue" Style="{StaticResource ModernTextBox}" 
                                     Width="80" Margin="0,0,10,0" Text="5"/>
                            <TextBox x:Name="TxtGradeTeacher" Style="{StaticResource ModernTextBox}" 
                                     Width="200" Margin="0,0,10,0" Text="Петров П.П."/>
                            <Button x:Name="BtnAddGrade" Content="Поставить оценку" FontSize="16" Click="AddGrade_Click"
                                    Style="{StaticResource ModernButton}" Margin="0,0,10,0"/>
                            <Button x:Name="BtnDeleteGrade" Content="Удалить" FontSize="16" Click="DeleteGrade_Click"
                                    Style="{StaticResource DeleteButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
            <!-- Вкладка 4: Приказы -->
            <TabItem Header="Приказы и распоряжения">
                <Border Background="White" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <DataGrid x:Name="GridOrders" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" Height="400" Margin="0,0,0,15">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="120"/>
                                <DataGridTextColumn Header="Текст приказа" Binding="{Binding Text}" Width="*"/>
                                <DataGridTextColumn Header="Адресат" Binding="{Binding Scope}" Width="150"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker x:Name="DateOrder" Width="130" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                            <TextBox x:Name="TxtOrderText" Style="{StaticResource ModernTextBox}" 
                                     Width="400" Margin="0,0,10,0" Text="Приказ о зачислении студентов"/>
                            <ComboBox x:Name="CmbOrderScope" Width="200" Margin="0,0,10,0"  VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Всем" Tag="ALL" IsSelected="True"/>
                                <ComboBoxItem Content="Факультет ИТ" Tag="FACULTY_IT"/>
                                <ComboBoxItem Content="Кафедра ПО" Tag="DEPT_PO"/>
                            </ComboBox>
                            <ComboBox x:Name="CmbOrderStatus" Width="150" Margin="0,0,10,0" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Активен" Tag="active" IsSelected="True"/>
                                <ComboBoxItem Content="Архив" Tag="archived"/>
                            </ComboBox>
                            <Button Content="Издать приказ" FontSize="16" Click="AddOrder_Click"
                                    Style="{StaticResource ModernButton}" Margin="0,0,10,0"/>
                            <Button Content="Удалить" FontSize="16" Click="DeleteOrder_Click"
                                    Style="{StaticResource DeleteButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
        <!-- Статусная строка -->
        <Border Grid.Row="3" Background="{StaticResource BackButtonColor}">
            <TextBlock x:Name="StatusText" Margin="20,15" 
                       Foreground="White" FontSize="16" FontWeight="Bold"
                       Text="Готов к работе. Выберите уровень для начала работы"/>
        </Border>
    </Grid>
</Window>
